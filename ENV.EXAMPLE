# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/thaifoon_university"

# NextAuth
NEXTAUTH_SECRET="generate-a-long-random-secret"
NEXTAUTH_URL="http://localhost:8000"

# Uploads (choose one backend)
# Public flag controls which endpoint the client uses
NEXT_PUBLIC_UPLOAD_TARGET="vercel" # vercel | cloudinary | s3 | builtin

# Vercel Blob (if using vercel uploads)
# No vars required locally; Vercel project must have Blob enabled.

# Cloudinary
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# AWS S3
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET_NAME="thaifoon-university-files"

# Playwright (tests)
PLAYWRIGHT_BASE_URL="http://localhost:8000"

